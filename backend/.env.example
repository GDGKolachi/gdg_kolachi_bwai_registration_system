# Database
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gdg_bwai
# Or use individual variables:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=gdg_bwai

# JWT — generate a strong random value, e.g. `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET

# Admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# Email (Resend)
RESEND_API_KEY=re_YOUR_RESEND_API_KEY

# resend.from.email=hello@example.com
# resend.from.name=GDG Kolachi

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Backend public URL (shortlisted email links: acknowledge + QR). Production: your Railway API URL.
APP_URL=http://localhost:3000

# Server
PORT=3000