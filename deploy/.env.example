# =============================================================================
# Production .env — copy this to /opt/gdg-bwai/.env on the VM and fill in.
# NEVER commit the real .env to git.
# =============================================================================

# ---- Postgres ----
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=gdg_bwai

# ---- JWT ----
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# ---- Admin seed account ----
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ---- Email (Resend) ----
RESEND_API_KEY=re_YOUR_RESEND_API_KEY

# ---- URLs ----
# Set FRONTEND_URL to your VM's external IP or domain (for CORS)
FRONTEND_URL=http://YOUR_VM_EXTERNAL_IP

# Set APP_URL to the public backend URL (used in email links)
APP_URL=http://YOUR_VM_EXTERNAL_IP/api

# ---- Server ----
PORT=3000
